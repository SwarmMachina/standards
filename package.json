{
  "name": "@swarmmachina/standards",
  "version": "2.0.0",
  "description": "Shared code style, linting rules, git conventions and project standards for SwarmMachina projects.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "bin": {
    "swm-standards": "./bin/swm-standards.mjs"
  },
  "scripts": {
    "check": "prettier . --check && eslint .",
    "fix": "eslint . --fix && prettier . --write",
    "init-git-hooks": "node git/setup-hooks.mjs",
    "test": "node --test tests/contracts.test.mjs",
    "test:fixtures": "node tests/package-fixtures.mjs",
    "verify": "pnpm run check && pnpm test && pnpm run test:fixtures"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarmMachina/standards.git"
  },
  "author": "SwarmMachina Team",
  "license": "Apache-2.0",
  "keywords": [
    "eslint",
    "prettier",
    "vue",
    "jsdoc",
    "standards",
    "swarmmachina"
  ],
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.2.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "vue-eslint-parser": "10.4.1"
  },
  "peerDependencies": {
    "typescript-eslint": "^8.65.0"
  },
  "peerDependenciesMeta": {
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": "^22.13.0 || 24.x"
  },
  "exports": {
    "./eslint-js": "./code-style/eslint-js.config.mjs",
    "./eslint-typescript": "./code-style/eslint-typescript.config.mjs",
    "./eslint-vue": "./code-style/eslint-vue.config.mjs",
    "./eslint-vue-typescript": "./code-style/eslint-vue-typescript.config.mjs",
    "./eslint-ts": "./code-style/eslint-ts.config.mjs",
    "./eslint.config.mjs": "./code-style/eslint.config.mjs",
    "./prettier": "./code-style/prettier.config.mjs",
    "./tsconfig": "./code-style/tsconfig.base.json",
    "./tsconfig.base.json": "./code-style/tsconfig.base.json",
    "./setup-hooks.mjs": "./git/setup-hooks.mjs",
    "./code-style/*.mjs": "./code-style/*.mjs",
    "./git/*.mjs": "./git/*.mjs"
  },
  "files": [
    "bin/",
    "code-style/",
    "git/",
    "git/.gitignore",
    "README.md"
  ]
}

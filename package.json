{
  "name": "@swarmmachina/standards",
  "version": "1.1.3",
  "description": "Shared code style, linting rules, git conventions and project standards for SwarmMachina projects.",
  "type": "module",
  "scripts": {
    "check": "prettier . --check && eslint . --ext .js,.vue",
    "fix": "eslint . --ext .js,.vue --fix && prettier . --write",
    "init-git-hooks": "node git/setup-hooks.mjs",
    "test": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarmMachina/standards.git"
  },
  "author": "SwarmMachina Team",
  "license": "Apache-2.0",
  "keywords": [
    "eslint",
    "prettier",
    "vue",
    "jsdoc",
    "standards",
    "swarmmachina"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    "./eslint.config.mjs": "./code-style/eslint.config.mjs",
    "./setup-hooks.mjs": "./git/setup-hooks.mjs",
    "./code-style/*.mjs": "./code-style/*.mjs",
    "./git/*.mjs": "./git/*.mjs"
  },
  "files": [
    "code-style/",
    "git/",
    "git/.gitignore",
    "README.md"
  ]
}
